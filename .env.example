# Core AIS settings
AIS_DB_PATH=/data/ais.duckdb
AIS_BACKEND=legacy_parquet
AIS_TENANT_ID=default
WEATHERMAN_EVENT_JOURNAL_PATH=/runtime/events/sse-events.jsonl

# Neptune archival bridge
NEPTUNE_STORE_ROOT=/data/neptune
NEPTUNE_SOURCES=noaa
NEPTUNE_MERGE=best
NEPTUNE_BBOX=
NEPTUNE_MMSI=
NEPTUNE_RAW_POLICY=metadata
NEPTUNE_OVERWRITE=false
NEPTUNE_API_KEYS_JSON=

# Neptune live ingest — runs inside the backend when AIS_LIVE=true (the old
# `ais-live` compose profile is gone: DuckDB can't share ais.duckdb between a
# writing and a reading process). The backend then writes AIS_DB_PATH,
# NEPTUNE_STORE_ROOT and NEPTUNE_LIVE_LANDING_DIR, and /data is read-only, so
# move them to /runtime, e.g. /runtime/ais.duckdb, /runtime/neptune,
# /runtime/neptune-live. Drop COMPOSE_PROFILES=ais-live from an older .env.
AIS_LIVE=false
NEPTUNE_LIVE_SOURCE=aisstream
NEPTUNE_LIVE_LANDING_DIR=/data/neptune-live
NEPTUNE_LIVE_BBOX=
NEPTUNE_LIVE_MMSI=
NEPTUNE_LIVE_MAX_MESSAGES=
NEPTUNE_LIVE_CLEANUP=false
NEPTUNE_LIVE_FLUSH_INTERVAL=60
NEPTUNE_LIVE_API_KEY=
