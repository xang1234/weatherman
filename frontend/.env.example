VITE_API_BASE_URL=http://localhost:8000

# WebGL data-tile pipeline is ON by default.
# Set to 'false' to fall back to raster TileJSON pipeline.
# VITE_USE_WEBGL_WEATHER=false

# Basemap PMTiles URL. Defaults to the extract the backend serves at
# /basemap/basemap.pmtiles (fetched by scripts/fetch_basemap.py).
# VITE_BASEMAP_URL=/basemap/basemap.pmtiles
